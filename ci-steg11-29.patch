new file mode 100644
index 0000000..4f15453
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,11 @@
+# Keeps the pinned GitHub Actions (commit SHAs) and the development dependencies up to date.
+version: 2
+updates:
+  - package-ecosystem: github-actions
+    directory: /
+    schedule:
+      interval: weekly
+  - package-ecosystem: npm
+    directory: /
+    schedule:
+      interval: weekly
