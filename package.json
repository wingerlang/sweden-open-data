{
  "name": "@wingerlang/sweden-open-data",
  "version": "0.11.1",
  "description": "Swedish open data, typed and dependency-free: electricity spot prices, weather forecasts and history, UV, pollen and air quality, VMA, crisis information and SMHI warnings, geocoding that understands Swedish addresses, consumer price indices from SCB with inflation arithmetic, and reference catalogues of universities and sports. Optional: authenticated vehicle lookup and experimental investment-company and vehicle-page adapters.",
  "license": "MIT",
  "author": "Johannes Winger-Lang",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./spot": {
      "types": "./dist/spot/mod.d.ts",
      "default": "./dist/spot/mod.js"
    },
    "./weather": {
      "types": "./dist/weather/mod.d.ts",
      "default": "./dist/weather/mod.js"
    },
    "./alerts": {
      "types": "./dist/alerts/mod.d.ts",
      "default": "./dist/alerts/mod.js"
    },
    "./geo": {
      "types": "./dist/geo/mod.d.ts",
      "default": "./dist/geo/mod.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./vehicles": {
      "types": "./dist/vehicles/mod.d.ts",
      "default": "./dist/vehicles/mod.js"
    },
    "./vehicles/free": {
      "types": "./dist/vehicles/free.d.ts",
      "default": "./dist/vehicles/free.js"
    },
    "./sports": {
      "types": "./dist/sports/mod.d.ts",
      "default": "./dist/sports/mod.js"
    },
    "./education": {
      "types": "./dist/education/mod.d.ts",
      "default": "./dist/education/mod.js"
    },
    "./economy": {
      "types": "./dist/economy/mod.d.ts",
      "default": "./dist/economy/mod.js"
    },
    "./investments": {
      "types": "./dist/investments/mod.d.ts",
      "default": "./dist/investments/mod.js"
    },
    "./anniversaries": {
      "types": "./dist/anniversaries/mod.d.ts",
      "default": "./dist/anniversaries/mod.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "dist",
    "tsconfig.build.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "sweden",
    "sverige",
    "open-data",
    "spot-price",
    "elpris",
    "weather",
    "smhi",
    "krisinformation",
    "vma",
    "geocoding",
    "kpi",
    "inflation",
    "scb"
  ],
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node dev/server.ts",
    "test:live": "node --test \"live/*.test.ts\"",
    "coverage": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.ts\" && node scripts/check-coverage.ts",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm run lint && npm run check:exports && npm run coverage",
    "check:exports": "node scripts/check-exports.ts",
    "lint": "node scripts/lint.ts",
    "fmt": "npx --yes prettier@3.8.1 --write .",
    "fmt:check": "npx --yes prettier@3.8.1 --check .",
    "smoke": "node examples/dashboard.ts",
    "examples": "node --test test/examples.test.ts",
    "load": "node scripts/load.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.ts"
  }
}
