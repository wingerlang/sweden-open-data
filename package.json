{
  "name": "@wingerlang/sweden-open-data",
  "version": "0.7.0",
  "description": "Swedish open data, typed and dependency-free: electricity spot prices, weather, VMA/crisis information and SMHI warnings, and geocoding that understands Swedish addresses.",
  "license": "MIT",
  "author": "Johannes Winger-Lang",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/mod.ts",
      "default": "./dist/mod.js"
    },
    "./spot": {
      "types": "./src/spot/mod.ts",
      "default": "./dist/spot/mod.js"
    },
    "./weather": {
      "types": "./src/weather/mod.ts",
      "default": "./dist/weather/mod.js"
    },
    "./alerts": {
      "types": "./src/alerts/mod.ts",
      "default": "./dist/alerts/mod.js"
    },
    "./geo": {
      "types": "./src/geo/mod.ts",
      "default": "./dist/geo/mod.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./dist/testing.js"
    },
    "./vehicles": {
      "types": "./src/vehicles/mod.ts",
      "default": "./dist/vehicles/mod.js"
    },
    "./education": {
      "types": "./src/education/mod.ts",
      "default": "./dist/education/mod.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "dist",
    "tsconfig.build.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "sweden",
    "sverige",
    "open-data",
    "spot-price",
    "elpris",
    "weather",
    "smhi",
    "krisinformation",
    "vma",
    "geocoding"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node dev/server.ts",
    "test:live": "node --test \"live/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm run coverage",
    "smoke": "node examples/dashboard.ts",
    "build": "tsc -p tsconfig.build.json"
  }
}
